# Devin Control configuration — copy to .env and fill in.
# Lines marked REQUIRED must be set; everything else has a default.

# REQUIRED — Devin API service-user key (Settings > Devin API > Service users).
# Use a Member-role service user; the key can spend your Devin quota.
DEVIN_API_KEY=cog_your_key_here

# REQUIRED — your Devin organization id (top of the same settings page).
DEVIN_ORG_ID=your_org_id

# REQUIRED — password for the web panel login (minimum 8 characters).
# Anyone with it can spend your Devin quota — make it long and unique.
APP_PASSWORD=change-me-to-a-long-passphrase

# Port the server listens on. Default: 8787
#PORT=8787

# Address the server binds to. Default: 127.0.0.1 (this machine only).
# Set to 0.0.0.0 to reach the panel from other devices on your network —
# only do that behind HTTPS (see "Reach it from your phone" in the README).
#HOST=127.0.0.1

# Devin API base URL. Default: https://api.devin.ai
# Only change this for testing (e.g. the bundled mock server in scripts/).
#DEVIN_API_BASE=https://api.devin.ai

# Set to 1 when the panel sits behind a reverse proxy / tunnel that
# terminates HTTPS (Cloudflare Tunnel, hosted deploys). Makes the session
# cookie Secure and uses the last X-Forwarded-For entry for rate limiting.
# Only enable it when a proxy in front of the app sets/appends that header;
# if the app is directly reachable, leave it off.
#TRUST_PROXY=0

# Secret used to sign the session cookie. Default: derived from
# APP_PASSWORD + DEVIN_API_KEY (stable across restarts). Recommended: set
# this to a long random string (e.g. `openssl rand -hex 32`).
#SESSION_SECRET=

# Directory for writable state (projects.json). Default: app directory.
# Set this in containers when mounting a data volume.
#DATA_DIR=

# Experimental, opt-in: enable the Local tab, which indexes Devin
# Desktop/CLI sessions stored on this machine. Unofficial — reads files
# under ~/Library/Application Support/Devin and your Devin CLI login
# token, and may break with any Devin update. Requires Node 22.5+.
# Only the exact value 1 enables it.
#ENABLE_LOCAL=0

# Override the Devin Desktop data location used by the Local tab.
# Default: ~/Library/Application Support/Devin/User (macOS).
#DEVIN_DESKTOP_DIR=
